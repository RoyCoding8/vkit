.venv/
.venv08/
# Optional platform-specific virtual environment.
.venv-posix/
# Subagent worktrees. These are full checkouts of this repository, one per
# concurrent worker, and committing them would nest a copy of the source inside
# the source. `.claude/` holds nothing else that belongs here.
.claude/
.worktrees/
__pycache__/
*.pyc
.pytest_cache/
dist/
build/
*.egg-info/

# Temporary tools and probes are not source material.
tmp/*

# Mutation-testing scratch: ablated, head and mine copies of the tree, written
# by whatever ablation is running. Three near-identical 80 KB modules are not
# source material, and no test or script resolves one by path.
.abl/

# Session scratch: probe scripts, run logs and sweep records from the repair
# wave. They are evidence for that work, not part of the product, and nothing
# in tests/ or scripts/ requires one to exist.
review/
