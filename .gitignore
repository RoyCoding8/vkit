.venv/
.venv08/
# The POSIX environment, created inside WSL for the GAP-2 run. A virtualenv on
# a POSIX host is no more a source artifact than one on Windows.
.venv-posix/
# Subagent worktrees. These are full checkouts of this repository, one per
# concurrent worker, and committing them would nest a copy of the source inside
# the source. `.claude/` holds nothing else that belongs here.
.claude/
.worktrees/
__pycache__/
*.pyc
.pytest_cache/
dist/
build/
*.egg-info/

# scratch only; tmp/research and tmp/source are preserved source material
tmp/*
!tmp/research/
!tmp/source/

# Decision trail. Committed deliberately: a reviewer needs it to trust the result.
