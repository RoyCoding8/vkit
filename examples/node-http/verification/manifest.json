{
  "schema_version": 1,
  "description": "A small HTTP service where creating an item is only observable by reading the list back, verified over real sockets.",
  "checks": [
    {
      "id": "items-api",
      "description": "Starts the real service twice, on ports the operating system assigns, and drives POST /items then GET /items over HTTP with literal expected responses.",
      "command": [
        "node",
        "verify-items.js",
        "--app",
        "src/items-server.js",
        "--out",
        "{{run_dir}}/result.json"
      ],
      "cwd": ".",
      "timeout_seconds": 180,
      "required_scenarios": [
        "get-on-an-empty-service-returns-an-empty-list",
        "post-then-get-returns-the-updated-list",
        "two-posts-accumulate-in-order",
        "a-post-without-a-name-is-rejected",
        "an-unknown-route-is-a-404",
        "two-instances-do-not-share-state"
      ],
      "artifact": "result.json",
      "prerequisites": [
        {
          "name": "node",
          "executable": "node",
          "args": ["--version"]
        }
      ],
      "inputs": ["src/items-server.js", "verify-items.js"]
    }
  ]
}
