diff --git a/translation/src/procedures.rs b/translation/src/procedures.rs
index e5f771f..ad4a1de 100644
--- a/translation/src/procedures.rs
+++ b/translation/src/procedures.rs
@@ -339,6 +339,19 @@ impl<'tcx, 'def> Scope<'tcx, 'def> {
         self.lookup_function(did).map(|meta| meta.get_mode())
     }
 
+    pub(crate) fn function_translation_status(&self, did: DefId) -> &'static str {
+        let key = ProcedureKey::Function(self.get_ordered_did(did));
+        if self.translated_procedures.contains_key(&key) {
+            "body_generated"
+        } else if self.specced_procedures.contains_key(&key) {
+            "spec_generated"
+        } else if self.procedure_meta.contains_key(&key) {
+            "registered_without_generated_body"
+        } else {
+            "not_registered"
+        }
+    }
+
     pub(crate) fn has_raw_mut_self(&self, did: DefId) -> bool {
         did.is_local() && self.raw_mut_self_functions.contains(&self.get_ordered_did(did))
     }
