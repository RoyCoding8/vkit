{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python}",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/vkit_hook.py",
              "SessionStart",
              "--project",
              "${user_config.project_root}"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python}",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/vkit_hook.py",
              "Stop",
              "--project",
              "${user_config.project_root}"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python}",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/vkit_hook.py",
              "SubagentStop",
              "--project",
              "${user_config.project_root}"
            ],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
