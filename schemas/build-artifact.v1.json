{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vkit.local/schemas/build-artifact.v1.json",
  "title": "Fixed offline build-check report",
  "type": "object",
  "required": ["schema_version", "status", "profile", "toolchain", "builds", "assertions"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["PASS", "FAIL", "BLOCKED"]},
    "profile": {"const": "offline-wheel-build-install-v1"},
    "toolchain": {
      "type": "object", "required": ["uv_version", "uv_sha256", "python_version", "python_sha256"],
      "additionalProperties": false,
      "properties": {
        "uv_version": {"type": "string"}, "uv_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "python_version": {"type": "string"}, "python_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "builds": {
      "type": "array", "maxItems": 2,
      "items": {
        "type": "object", "required": ["index", "exit_code", "stdout_bytes", "stdout_sha256", "stderr_bytes", "stderr_sha256", "wheel"],
        "additionalProperties": false,
        "properties": {
          "index": {"type": "integer", "enum": [1, 2]}, "exit_code": {"type": "integer"},
          "stdout_bytes": {"type": "integer", "minimum": 0}, "stdout_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "stderr_bytes": {"type": "integer", "minimum": 0}, "stderr_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "wheel": {"type": ["object", "null"], "required": ["filename", "bytes", "sha256"],
            "additionalProperties": false, "properties": {
              "filename": {"type": "string"}, "bytes": {"type": "integer", "minimum": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "same_wheel_bytes": {"type": "boolean"},
    "assertions": {
      "type": "array", "maxItems": 128,
      "items": {
        "type": "object", "required": ["id", "result", "expected", "observed"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1}, "result": {"enum": ["PASS", "FAIL"]},
          "expected": {}, "observed": {}
        }
      }
    },
    "problem": {
      "type": "object", "required": ["reason", "detail"], "additionalProperties": false,
      "properties": {"reason": {"type": "string", "minLength": 1}, "detail": {"type": "string", "maxLength": 2048}}
    }
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "BLOCKED"}}, "required": ["status"]}, "then": {"required": ["problem"]}},
    {"if": {"properties": {"status": {"enum": ["PASS", "FAIL"]}}, "required": ["status"]}, "then": {"required": ["same_wheel_bytes"], "properties": {"builds": {"minItems": 2}, "assertions": {"minItems": 1}}}}
  ]
}
