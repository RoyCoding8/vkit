{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vkit.local/schemas/change-certification.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "base_oid",
    "candidate_oid",
    "intent_sha256",
    "claim"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "base_oid": { "$ref": "#/$defs/git_oid" },
    "candidate_oid": { "$ref": "#/$defs/git_oid" },
    "intent_sha256": { "$ref": "#/$defs/sha256" },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "contract"],
      "properties": {
        "kind": { "const": "finite_contract" },
        "contract": { "$ref": "#/$defs/contract" }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "git_oid": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 40,
          "maxLength": 40,
          "pattern": "^[0-9a-f]{40}$"
        },
        {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        }
      ]
    },
    "token": { "type": "string", "minLength": 1 },
    "token_set": {
      "type": "array",
      "items": { "$ref": "#/$defs/token" },
      "uniqueItems": true
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding",
        "inputs",
        "observations",
        "codec_sha256",
        "observation_sha256",
        "environment_sha256"
      ],
      "properties": {
        "binding": { "$ref": "#/$defs/token" },
        "inputs": {
          "allOf": [
            { "$ref": "#/$defs/token_set" },
            { "minItems": 1 }
          ]
        },
        "observations": {
          "allOf": [
            { "$ref": "#/$defs/token_set" },
            { "minItems": 1 }
          ]
        },
        "codec_sha256": { "$ref": "#/$defs/sha256" },
        "observation_sha256": { "$ref": "#/$defs/sha256" },
        "environment_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "output_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "outputs"],
      "properties": {
        "input": { "$ref": "#/$defs/token" },
        "outputs": {
          "allOf": [
            { "$ref": "#/$defs/token_set" },
            { "minItems": 1 }
          ]
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "admissible_inputs", "allowed_outputs"],
      "properties": {
        "domain": { "$ref": "#/$defs/domain" },
        "admissible_inputs": { "$ref": "#/$defs/token_set" },
        "allowed_outputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/output_row" }
        }
      }
    }
  }
}
