{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vkit.local/schemas/check-artifact.v1.json",
  "title": "vkit check artifact, schema version 1",
  "description": "Written by the check. This is the only channel through which a check can report what it observed.",
  "type": "object",
  "required": [
    "schema_version",
    "scenarios"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "description": {
      "type": "string"
    },
    "scenarios": {
      "type": "array",
      "description": "May be empty here on purpose. An artifact that reports no scenarios is a distinct, more actionable BLOCKED reason than a malformed one, so the emptiness rule lives in the parser rather than in this schema. It still cannot produce PASS.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "result",
          "observation"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL"
            ]
          },
          "observation": {
            "type": "string",
            "minLength": 1,
            "description": "What was actually seen, so a reader can judge without re-running."
          }
        }
      }
    },
    "measurements": {
      "type": "array",
      "description": "Numbers the check measured. A budget in the manifest can fail a run on them.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "value",
          "unit",
          "better"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "better": {
            "enum": [
              "lower",
              "higher"
            ]
          }
        }
      }
    }
  }
}
