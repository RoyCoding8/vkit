{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vkit.local/schemas/evidence-record.v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "subject", "source", "inputs", "assurance", "claim_outcome", "outcome", "obligations", "artifacts"],
  "$defs": {
    "logical_trust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "engine", "scope", "dependencies", "axioms", "independent_check"],
      "properties": {
        "schema_version": {"const": 1},
        "engine": {
          "type": "object", "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "version": {"type": ["string", "null"]}
          }
        },
        "scope": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "items", "assumptions"],
          "properties": {
            "kind": {"type": "string", "minLength": 1},
            "items": {"type": "array"},
            "assumptions": {"$ref": "#/$defs/report_section"}
          }
        },
        "dependencies": {"$ref": "#/$defs/report_section"},
        "axioms": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "by_obligation"],
          "properties": {
            "status": {"enum": ["reported", "not_reported"]},
            "by_obligation": {
              "type": "array",
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["obligation", "status", "items"],
                "properties": {
                  "obligation": {"type": "string", "minLength": 1},
                  "status": {"enum": ["reported", "not_reported"]},
                  "items": {"type": "array", "items": {"type": "string"}}
                }
              }
            }
          }
        },
        "independent_check": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "checker", "certificate"],
          "properties": {
            "status": {"enum": ["not_provided", "checked", "rejected", "unknown"]},
            "checker": {
              "oneOf": [
                {"type": "null"},
                {
                  "type": "object", "additionalProperties": false,
                  "required": ["name", "version", "digest"],
                  "properties": {
                    "name": {"type": "string", "minLength": 1},
                    "version": {"type": ["string", "null"]},
                    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                  }
                }
              ]
            },
            "certificate": {
              "oneOf": [
                {"type": "null"},
                {
                  "type": "object", "additionalProperties": false,
                  "required": ["path", "sha256"],
                  "properties": {
                    "path": {"type": "string", "minLength": 1},
                    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                  }
                }
              ]
            }
          },
          "allOf": [{
            "if": {"properties": {"status": {"const": "checked"}}},
            "then": {"properties": {"checker": {"type": "object"}}}
          }]
        }
      }
    },
    "report_section": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "items"],
      "properties": {
        "status": {"enum": ["reported", "policy_bound", "not_reported", "unchecked"]},
        "items": {"type": "array"}
      }
    }
  },
  "properties": {
    "authority": {"$ref":"job.v2.json#/$defs/authority"},
    "schema_version": {"const": 2},
    "job_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"enum": ["registered_check", "formal_goal", "change_certification"]},
        "id": {"type": "string", "minLength": 1}
      }
    },
    "source": {"$ref": "job.v2.json#/$defs/source"},
    "target_source": {"$ref": "job.v2.json#/$defs/source"},
    "trusted_target_oid": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"},
    "change_request": {"$ref": "change-certification.v1.json"},
    "bound_request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "method_plan": {"type": "object"},
    "implementation": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "source_proof": {"const": false},
    "approval_authority": {"const": false},
    "inputs": {"type": "object"},
    "assurance": {"type": "string", "minLength": 1},
    "claim_outcome": {"enum": ["established", "refuted", "unknown"]},
    "outcome": {
      "type": "object",
      "required": ["result"],
      "properties": {"result": {"enum": ["PASS", "FAIL", "BLOCKED"]}}
    },
    "obligations": {"type": ["object", "array", "null"]},
    "artifacts": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "check_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "backend": {"type": "object"},
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checker_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "method": {"enum": ["verus_source", "change_methods"]},
    "category": {"enum": ["source_verification", "change_certification"]},
    "scope": {"enum": ["required_api", "shadow"]},
    "verification": {
      "type": "object",
      "properties": {
        "logical_trust": {"$ref": "#/$defs/logical_trust"},
        "source_diagnostics": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": true
    }
  },
  "allOf": [{
    "if": {"properties": {"subject": {"properties": {"kind": {"const": "formal_goal"}}}}},
    "then": {
      "required": ["policy_sha256", "package_sha256", "checker_sha256", "method", "category", "scope", "verification"],
      "properties": {"assurance": {"const": "trusted_engine"}, "method": {"const": "verus_source"}, "category": {"const": "source_verification"}, "scope": {"const": "required_api"}},
      "not": {"anyOf": [{"required": ["target_source"]}, {"required": ["trusted_target_oid"]}, {"required": ["change_request"]}, {"required": ["bound_request_sha256"]}, {"required": ["method_plan"]}, {"required": ["implementation"]}, {"required": ["source_proof"]}, {"required": ["approval_authority"]}]}
    },
    "else": {
      "if": {"properties": {"subject": {"properties": {"kind": {"const": "change_certification"}}}}},
      "then": {
        "required": ["target_source", "trusted_target_oid", "change_request", "bound_request_sha256", "method_plan", "implementation", "method", "category", "scope", "verification", "source_proof", "approval_authority"],
        "properties": {"assurance": {"const": "empirical"}, "claim_outcome": {"const": "unknown"}, "method": {"const": "change_methods"}, "category": {"const": "change_certification"}, "scope": {"const": "shadow"}},
        "not": {"anyOf": [{"required": ["authority"]}, {"required": ["check_digest"]}, {"required": ["backend"]}, {"required": ["policy_sha256"]}, {"required": ["package_sha256"]}, {"required": ["checker_sha256"]}]}
      },
      "else": {
        "required": ["check_digest", "backend"],
        "properties": {"method": {"const": "verus_source"}, "category": {"const": "source_verification"}, "scope": {"const": "required_api"}},
        "not": {"anyOf": [{"required": ["target_source"]}, {"required": ["trusted_target_oid"]}, {"required": ["change_request"]}, {"required": ["bound_request_sha256"]}, {"required": ["method_plan"]}, {"required": ["implementation"]}, {"required": ["source_proof"]}, {"required": ["approval_authority"]}]}
      }
    }
  }]
}
