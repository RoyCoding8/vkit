{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vkit.local/schemas/finite-differences.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "intent_sha256", "guards"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "finite_differences"},
    "intent_sha256": {"$ref": "#/$defs/sha256"},
    "guards": {
      "type": "array",
      "items": {"$ref": "#/$defs/guard"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "token": {
      "type": "string",
      "minLength": 1
    },
    "guard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requirements"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]*$",
          "not": {"pattern": "\\s"}
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/output_row"}
        }
      }
    },
    "output_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "outputs"],
      "properties": {
        "input": {"$ref": "#/$defs/token"},
        "outputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/token"}
        }
      }
    }
  }
}
