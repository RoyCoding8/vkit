{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vkit.local/schemas/job.v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "subject", "source"],
  "properties": {
    "authority": {"$ref":"#/$defs/authority"},
    "schema_version": {"const": 2},
    "job_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"enum": ["registered_check", "formal_goal", "change_certification"]},
        "id": {"type": "string", "minLength": 1}
      }
    },
    "source": {"$ref": "#/$defs/source"},
    "target_source": {"$ref": "#/$defs/source"},
    "trusted_target_oid": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"},
    "change_request": {"$ref": "change-certification.v1.json"},
    "bound_request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "method_plan": {"type": "object"},
    "implementation": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "definition": {"type": "object"},
    "check_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "baseline": {"type": ["object", "null"]},
    "backend": {"type": "object"},
    "inputs": {"type": "object"},
    "request": {"$ref": "verification-request.v2.json",
                "not": {"anyOf": [{"required": ["wait_seconds"]}, {"required": ["reuse"]}]}},
    "component": {"$ref": "manifest.v3.json#/$defs/formal_component"},
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checker_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "oneOf": [
    {
      "properties": {
        "subject": {"properties": {"kind": {"const": "registered_check"}}}
      },
      "required": ["definition", "check_digest", "baseline", "backend", "inputs"],
      "not": {"anyOf": [{"required": ["request"]}, {"required": ["component"]}, {"required": ["policy_sha256"]}, {"required": ["package_sha256"]}, {"required": ["checker_sha256"]}, {"required": ["target_source"]}, {"required": ["trusted_target_oid"]}, {"required": ["change_request"]}, {"required": ["bound_request_sha256"]}, {"required": ["method_plan"]}, {"required": ["implementation"]}]}
    },
    {
      "properties": {
        "subject": {"properties": {"kind": {"const": "formal_goal"}}}
      },
      "required": ["request", "component", "policy_sha256", "package_sha256", "checker_sha256"],
      "not": {"anyOf": [{"required": ["definition"]}, {"required": ["check_digest"]}, {"required": ["baseline"]}, {"required": ["backend"]}, {"required": ["inputs"]}, {"required": ["target_source"]}, {"required": ["trusted_target_oid"]}, {"required": ["change_request"]}, {"required": ["bound_request_sha256"]}, {"required": ["method_plan"]}, {"required": ["implementation"]}]}
    },
    {
      "properties": {"subject": {"properties": {"kind": {"const": "change_certification"}}}},
      "required": ["target_source", "trusted_target_oid", "change_request", "bound_request_sha256", "method_plan", "implementation"],
      "not": {"anyOf": [{"required": ["definition"]}, {"required": ["check_digest"]}, {"required": ["baseline"]}, {"required": ["backend"]}, {"required": ["inputs"]}, {"required": ["request"]}, {"required": ["component"]}, {"required": ["policy_sha256"]}, {"required": ["package_sha256"]}, {"required": ["checker_sha256"]}, {"required": ["authority"]}]}
    }
  ],
  "$defs": {
    "authority": {"type":"object","additionalProperties":false,"required":["kind","target_commit","target_tree","manifest_blob_oid","manifest","implementation"],"properties":{"kind":{"const":"target_policy"},"target_commit":{"type":"string","pattern":"^([0-9a-f]{40}|[0-9a-f]{64})$"},"target_tree":{"type":"string","pattern":"^([0-9a-f]{40}|[0-9a-f]{64})$"},"manifest_blob_oid":{"type":"string","pattern":"^([0-9a-f]{40}|[0-9a-f]{64})$"},"manifest":{"type":"object"},"implementation":{"type":"object","additionalProperties":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "object_format", "commit", "tree", "parents", "files", "digest"],
      "properties": {
        "kind": {"enum": ["working_tree", "git_commit"]},
        "object_format": {"enum": ["sha1", "sha256"]},
        "commit": {"type": ["string", "null"]},
        "tree": {"type": ["string", "null"]},
        "parents": {"type": "array", "items": {"type": "string"}},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "mode", "blob_oid", "raw_sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "mode": {"enum": ["100644", "100755"]},
              "blob_oid": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"},
              "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    }
  }
}
