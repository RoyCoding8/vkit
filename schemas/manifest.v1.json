{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vkit.local/schemas/manifest.v1.json",
  "title": "vkit manifest, schema version 1",
  "type": "object",
  "required": ["schema_version", "checks"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "description": { "type": "string" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "command", "timeout_seconds", "required_scenarios", "artifact"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "description": "Stable identifier agents select. Never an executable path."
          },
          "description": { "type": "string" },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "description": "Executable followed by arguments. Never a shell string."
          },
          "cwd": {
            "type": "string",
            "description": "Repository-relative working directory. Must not escape the root."
          },
          "timeout_seconds": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 86400,
            "description": "Finite and positive. A missing bound is a rejection, not infinity."
          },
          "required_scenarios": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "description": "Scenario ids that must appear. At least one, per CONTRACT.md."
          },
          "artifact": {
            "type": "string",
            "minLength": 1,
            "description": "Path the check writes, resolved against the run artifact directory."
          },
          "prerequisites": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "executable"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "executable": { "type": "string", "minLength": 1 },
                "args": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "inputs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "description": "Repository-relative files the check reads. Part of source identity."
          }
        }
      }
    }
  }
}
