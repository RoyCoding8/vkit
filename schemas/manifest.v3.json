{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vkit.local/schemas/manifest.v3.json",
  "title": "VKit manifest, schema version 3",
  "description": "Registered checks and owned formal component policies. Evidence methods are determined by the executor.",
  "type": "object",
  "required": [
    "schema_version",
    "checks"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 3
    },
    "description": {
      "type": "string"
    },
    "checks": {
      "type": "array",
      "minItems": 0,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/scenario"
          },
          {
            "$ref": "#/$defs/pytest"
          },
          {
            "$ref": "#/$defs/node_test"
          },
          {
            "$ref": "#/$defs/property"
          },
          {
            "$ref": "#/$defs/lean"
          },
          {
            "$ref": "#/$defs/tlc"
          },
          {
            "$ref": "#/$defs/static"
          },
          {
            "$ref": "#/$defs/external"
          }
        ]
      }
    },
    "formal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "components"
      ],
      "properties": {
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/formal_component"
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "description": "Stable identifier agents select. Never an executable path."
    },
    "cwd": {
      "type": "string"
    },
    "timeout": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 86400,
      "description": "Finite and positive. A missing bound is a rejection, not infinity."
    },
    "artifact": {
      "type": "string",
      "minLength": 1
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "executable"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "executable": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Repository-relative files the check reads. Part of source identity."
    },
    "expectations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Explicit subset of inputs that supplies expected observations. [] means the approved driver contains its expectations; omission is unresolved in protected verification."
    },
    "subject": {
      "type": "object",
      "required": [
        "paths",
        "digest"
      ],
      "additionalProperties": false,
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "digest": {
          "type": [
            "string",
            "null"
          ],
          "description": "null means the owner has not declared an expected digest yet. vkit measures it and the receipt carries the measurement."
        }
      },
      "description": "What the check is about."
    },
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "runner": {
      "type": "object",
      "required": [
        "executable",
        "base_argv"
      ],
      "additionalProperties": false,
      "properties": {
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "base_argv": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "How vkit launches the runner. An argument array, never a shell string."
    },
    "testIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Test node ids that must appear. At least one: a check that exercises nothing and passes is the failure CONTRACT.md forbids."
    },
    "moduleRef": {
      "type": "object",
      "required": [
        "module",
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "module": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "A named module and the file it lives in. The name is never inferred from the path."
    },
    "toolchain": {
      "type": "object",
      "required": [
        "tool"
      ],
      "additionalProperties": false,
      "properties": {
        "tool": {
          "enum": [
            "lean",
            "tlc"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "comparator": {
          "type": [
            "string",
            "null"
          ]
        },
        "jar_sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "description": "The toolchain a formal check is pinned to. No argv is derived from this until checkpoint 10.3 confirms the comparator contract."
    },
    "pinnedFile": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "pinnedCommand": {
      "type": "object",
      "required": [
        "executable"
      ],
      "additionalProperties": false,
      "properties": {
        "executable": {
          "$ref": "#/$defs/pinnedFile"
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/pinnedFile"
          }
        }
      },
      "description": "One argument-vector command. The executable and each declared script/dependency are content-pinned; supported argument placeholders are documented in backend-protocol.md."
    },
    "bounds": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      },
      "description": "Named model bounds. Part of the obligation rather than a receipt detail, because a run at different bounds is a different claim."
    },
    "scenario": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "command",
        "timeout_seconds",
        "required_scenarios",
        "artifact",
        "subject",
        "claim_id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "scenario"
        },
        "description": {
          "type": "string"
        },
        "cwd": {
          "$ref": "#/$defs/cwd"
        },
        "timeout_seconds": {
          "$ref": "#/$defs/timeout"
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "prerequisites": {
          "$ref": "#/$defs/prerequisites"
        },
        "inputs": {
          "$ref": "#/$defs/inputs"
        },
        "expectations": {
          "$ref": "#/$defs/expectations"
        },
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "claim_id": {
          "$ref": "#/$defs/claim_id"
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Executable followed by arguments. Never a shell string. Only a scenario check carries one; vkit launches every other kind from its own fields."
        },
        "required_scenarios": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Scenario ids that must appear. This branch has no field for a theorem, which is what makes a scenario driver claiming theorem_checking structurally impossible rather than merely checked."
        },
        "budgets": {
          "$ref": "#/$defs/budgets"
        }
      }
    },
    "pytest": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "required_tests",
        "runner",
        "report_format",
        "expect_report_version",
        "timeout_seconds",
        "artifact",
        "subject",
        "claim_id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "pytest"
        },
        "description": {
          "type": "string"
        },
        "cwd": {
          "$ref": "#/$defs/cwd"
        },
        "timeout_seconds": {
          "$ref": "#/$defs/timeout"
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "prerequisites": {
          "$ref": "#/$defs/prerequisites"
        },
        "inputs": {
          "$ref": "#/$defs/inputs"
        },
        "expectations": {
          "$ref": "#/$defs/expectations"
        },
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "claim_id": {
          "$ref": "#/$defs/claim_id"
        },
        "required_tests": {
          "$ref": "#/$defs/testIds"
        },
        "runner": {
          "$ref": "#/$defs/runner"
        },
        "report_format": {
          "enum": [
            "pytest_json_report"
          ]
        },
        "expect_report_version": {
          "type": "integer",
          "minimum": 1
        },
        "generator": {
          "type": "null"
        }
      }
    },
    "node_test": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "required_tests",
        "runner",
        "report_format",
        "expect_report_version",
        "timeout_seconds",
        "artifact",
        "subject",
        "claim_id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "node_test"
        },
        "description": {
          "type": "string"
        },
        "cwd": {
          "$ref": "#/$defs/cwd"
        },
        "timeout_seconds": {
          "$ref": "#/$defs/timeout"
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "prerequisites": {
          "$ref": "#/$defs/prerequisites"
        },
        "inputs": {
          "$ref": "#/$defs/inputs"
        },
        "expectations": {
          "$ref": "#/$defs/expectations"
        },
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "claim_id": {
          "$ref": "#/$defs/claim_id"
        },
        "required_tests": {
          "$ref": "#/$defs/testIds"
        },
        "runner": {
          "$ref": "#/$defs/runner"
        },
        "report_format": {
          "enum": [
            "node_tap"
          ]
        },
        "expect_report_version": {
          "type": "integer",
          "minimum": 1
        },
        "generator": {
          "type": "null"
        }
      }
    },
    "property": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "required_tests",
        "runner",
        "report_format",
        "expect_report_version",
        "generator",
        "timeout_seconds",
        "artifact",
        "subject",
        "claim_id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "property"
        },
        "description": {
          "type": "string"
        },
        "cwd": {
          "$ref": "#/$defs/cwd"
        },
        "timeout_seconds": {
          "$ref": "#/$defs/timeout"
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "prerequisites": {
          "$ref": "#/$defs/prerequisites"
        },
        "inputs": {
          "$ref": "#/$defs/inputs"
        },
        "expectations": {
          "$ref": "#/$defs/expectations"
        },
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "claim_id": {
          "$ref": "#/$defs/claim_id"
        },
        "required_tests": {
          "$ref": "#/$defs/testIds"
        },
        "runner": {
          "$ref": "#/$defs/runner"
        },
        "report_format": {
          "enum": [
            "pytest_json_report"
          ]
        },
        "expect_report_version": {
          "type": "integer",
          "minimum": 1
        },
        "generator": {
          "type": "object",
          "required": [
            "max_examples",
            "stateful_step_count",
            "deadline",
            "suppress_health_check"
          ],
          "additionalProperties": false,
          "properties": {
            "max_examples": {
              "type": "integer",
              "minimum": 1
            },
            "stateful_step_count": {
              "type": "integer",
              "minimum": 0
            },
            "deadline": {
              "type": [
                "number",
                "null"
              ],
              "exclusiveMinimum": 0
            },
            "suppress_health_check": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "description": "Required, and the reason this branch is the only route to category `property`. The classification comes from this block in the manifest, cross-checked against the policy, never from hypothesis being importable in the child."
        },
        "replay": {
          "type": "object",
          "required": [
            "database",
            "seed"
          ],
          "additionalProperties": false,
          "properties": {
            "database": {
              "type": "string",
              "minLength": 1
            },
            "seed": {
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "description": "Where a failing sequence is retained. A null seed means the generator chooses and the choice is not pinned."
        }
      }
    },
    "lean": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "challenge",
        "theorems",
        "profile",
        "permitted_axioms",
        "toolchain",
        "timeout_seconds",
        "artifact",
        "subject",
        "claim_id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "lean"
        },
        "description": {
          "type": "string"
        },
        "cwd": {
          "$ref": "#/$defs/cwd"
        },
        "timeout_seconds": {
          "$ref": "#/$defs/timeout"
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "prerequisites": {
          "$ref": "#/$defs/prerequisites"
        },
        "inputs": {
          "$ref": "#/$defs/inputs"
        },
        "expectations": {
          "$ref": "#/$defs/expectations"
        },
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "claim_id": {
          "$ref": "#/$defs/claim_id"
        },
        "challenge": {
          "$ref": "#/$defs/moduleRef"
        },
        "theorems": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Named theorems that must hold. At least one: a lean check with no theorem asserts nothing a scenario check could not."
        },
        "profile": {
          "enum": [
            "unreviewed_agent",
            "reviewed_proof_sources"
          ],
          "description": "reviewed_proof_sources rechecks human-reviewed sources with the kernel. unreviewed_agent checks an agent's solution module against the frozen challenge with leanprover/comparator."
        },
        "permitted_axioms": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "The audited axiom set. A theorem proved with an axiom outside this list is a mismatch, and mismatches are gaps."
        },
        "toolchain": {
          "$ref": "#/$defs/toolchain"
        },
        "solution": {
          "$ref": "#/$defs/moduleRef",
          "description": "The module an agent writes its proof in. Required for the unreviewed_agent profile."
        },
        "challenge_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "sha256 of the challenge file with CRLF folded to LF. Freezes the statements; required for the unreviewed_agent profile."
        }
      }
    },
    "tlc": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "model",
        "config",
        "properties",
        "bounds",
        "fingerprint",
        "toolchain",
        "timeout_seconds",
        "artifact",
        "subject",
        "claim_id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "tlc"
        },
        "description": {
          "type": "string"
        },
        "cwd": {
          "$ref": "#/$defs/cwd"
        },
        "timeout_seconds": {
          "$ref": "#/$defs/timeout"
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "prerequisites": {
          "$ref": "#/$defs/prerequisites"
        },
        "inputs": {
          "$ref": "#/$defs/inputs"
        },
        "expectations": {
          "$ref": "#/$defs/expectations"
        },
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "claim_id": {
          "$ref": "#/$defs/claim_id"
        },
        "model": {
          "$ref": "#/$defs/moduleRef"
        },
        "config": {
          "type": "string",
          "minLength": 1
        },
        "properties": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "bounds": {
          "$ref": "#/$defs/bounds"
        },
        "fingerprint": {
          "type": "object",
          "required": [
            "constants_from_config",
            "checksum_states",
            "workers"
          ],
          "additionalProperties": false,
          "properties": {
            "constants_from_config": {
              "type": "boolean"
            },
            "checksum_states": {
              "type": "boolean"
            },
            "workers": {
              "type": "integer",
              "minimum": 1
            }
          },
          "description": "How the state fingerprint is computed. workers: 1 is not arbitrary: with -workers auto each worker prints its own summary and they interleave, so the first match is whichever finished first rather than the run total."
        },
        "toolchain": {
          "$ref": "#/$defs/toolchain"
        }
      }
    },
    "budgets": {
      "type": "array",
      "description": "Limits on measurements the check reports. limit is an absolute bound in the measurement's direction; max_regression_pct compares with a baseline a human pinned.",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "limit": {
            "type": "number"
          },
          "max_regression_pct": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "static": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "command",
        "timeout_seconds",
        "artifact",
        "subject",
        "claim_id"
      ],
      "additionalProperties": false,
      "description": "An analyzer run whose SARIF report is the artifact. Findings outside the accepted baseline fail.",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "description": {
          "type": "string"
        },
        "cwd": {
          "$ref": "#/$defs/cwd"
        },
        "timeout_seconds": {
          "$ref": "#/$defs/timeout"
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "prerequisites": {
          "$ref": "#/$defs/prerequisites"
        },
        "inputs": {
          "$ref": "#/$defs/inputs"
        },
        "expectations": {
          "$ref": "#/$defs/expectations"
        },
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "claim_id": {
          "$ref": "#/$defs/claim_id"
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Executable followed by arguments. Never a shell string. Only a scenario check carries one; vkit launches every other kind from its own fields."
        },
        "kind": {
          "const": "static"
        }
      }
    },
    "external": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "specification",
        "obligations",
        "assumptions",
        "model_scope",
        "assurance",
        "evidence_artifacts",
        "backend",
        "checker",
        "timeout_seconds",
        "artifact",
        "subject",
        "claim_id"
      ],
      "additionalProperties": false,
      "description": "A pinned evidence producer and an independently pinned checker. A producer status or exit code alone never establishes an obligation.",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "external"
        },
        "description": {
          "type": "string"
        },
        "cwd": {
          "$ref": "#/$defs/cwd"
        },
        "timeout_seconds": {
          "$ref": "#/$defs/timeout"
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "prerequisites": {
          "$ref": "#/$defs/prerequisites"
        },
        "inputs": {
          "$ref": "#/$defs/inputs"
        },
        "expectations": {
          "$ref": "#/$defs/expectations"
        },
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "claim_id": {
          "$ref": "#/$defs/claim_id"
        },
        "specification": {
          "type": "string",
          "minLength": 1,
          "description": "Repository-relative frozen specification file."
        },
        "obligations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "assumptions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "model_scope": {
          "type": "string",
          "minLength": 1
        },
        "assurance": {
          "enum": [
            "kernel_proof",
            "trusted_engine"
          ]
        },
        "evidence_artifacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "backend": {
