{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vkit.local/schemas/paired-execution-report.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "scope",
    "status",
    "source_proof",
    "dependency_closure_checked",
    "os_sandbox",
    "request_sha256",
    "binding",
    "source",
    "input_selection",
    "repetitions",
    "resource_limits",
    "resource_usage",
    "resource_scope",
    "samples",
    "shrinking",
    "identities",
    "semantic_artifacts",
    "builds",
    "failures",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "paired_execution"},
    "scope": {"const": "sampled_paired_execution"},
    "status": {
      "enum": [
        "samples_within_contract",
        "observed_violation",
        "unknown",
        "infrastructure_failure"
      ]
    },
    "source_proof": {"const": false},
    "dependency_closure_checked": {"const": false},
    "os_sandbox": {"const": false},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "binding": {
      "oneOf": [
        {"$ref": "https://vkit.invalid/schemas/witness.v1.json#/$defs/binding"},
        {"type": "null"}
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_oid", "candidate_oid", "base_capture_sha256", "candidate_capture_sha256"],
      "properties": {
        "base_oid": {"$ref": "#/$defs/git_oid"},
        "candidate_oid": {"$ref": "#/$defs/git_oid"},
        "base_capture_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_capture_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "input_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["admissible_count", "selected", "omitted_count"],
      "properties": {
        "admissible_count": {"type": "integer", "minimum": 1},
        "selected": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/token"}},
        "omitted_count": {"type": "integer", "minimum": 0}
      }
    },
    "repetitions": {"type": "integer", "minimum": 1, "maximum": 32},
    "resource_limits": {"$ref": "#/$defs/resource_limits"},
    "resource_usage": {"$ref": "#/$defs/resource_usage"},
    "resource_scope": {
      "const": "Process stdout/stderr and paired-run wall time only; Git capture, generated files, and retained binaries have no OS quota."
    },
    "samples": {"type": "array", "items": {"$ref": "#/$defs/sample"}},
    "shrinking": {"$ref": "#/$defs/shrinking"},
    "identities": {"$ref": "#/$defs/identities"},
    "semantic_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "binding": {"$ref": "#/$defs/artifact"},
        "codec": {"$ref": "#/$defs/artifact"},
        "observation": {"$ref": "#/$defs/artifact"},
        "environment": {"$ref": "#/$defs/artifact"}
      }
    },
    "builds": {"type": "array", "items": {"$ref": "#/$defs/build"}},
    "failures": {"type": "array", "items": {"$ref": "#/$defs/failure"}},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "git_oid": {
      "oneOf": [
        {"type": "string", "minLength": 40, "maxLength": 40, "pattern": "^[0-9a-f]{40}$"},
        {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"}
      ]
    },
    "token": {"type": "string", "minLength": 1, "pattern": "^(0|[1-9][0-9]*)$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "media_type"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "^[^/][^\\\\:]*$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "media_type": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.+-]*/[a-z0-9][a-z0-9.+-]*$"}
      }
    },
    "identities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner", "runtime"],
      "properties": {
        "runner": {"oneOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]},
        "runtime": {"oneOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]}
      }
    },
    "resource_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_process_invocations", "max_output_bytes_per_process", "max_total_process_output_bytes", "wall_deadline_seconds"],
      "properties": {
        "max_process_invocations": {"type": "integer", "minimum": 1, "maximum": 128},
        "max_output_bytes_per_process": {"type": "integer", "minimum": 1, "maximum": 65536},
        "max_total_process_output_bytes": {"type": "integer", "minimum": 1, "maximum": 8388608},
        "wall_deadline_seconds": {"type": "integer", "minimum": 1, "maximum": 300}
      }
    },
    "resource_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["process_invocations", "process_output_bytes", "elapsed_seconds"],
      "properties": {
        "process_invocations": {"type": "integer", "minimum": 0, "maximum": 128},
        "process_output_bytes": {"type": "integer", "minimum": 0, "maximum": 8388608},
        "elapsed_seconds": {"type": "number", "minimum": 0}
      }
    },
    "run_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "value", "stdout", "stderr"],
      "properties": {
        "outcome": {"enum": ["validated_output", "incomplete"]},
        "value": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 4294967295}, {"type": "null"}]},
        "stdout": {"oneOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]},
        "stderr": {"oneOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]}
      },
      "oneOf": [
        {
          "properties": {
            "outcome": {"const": "validated_output"},
            "value": {"type": "integer", "minimum": 0, "maximum": 4294967295},
            "stdout": {"$ref": "#/$defs/artifact"}
          }
        },
        {
          "properties": {
            "outcome": {"const": "incomplete"},
            "value": {"type": "null"}
          }
        }
      ]
    },
    "sample_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repetition", "base", "candidate"],
      "properties": {
        "repetition": {"type": "integer", "minimum": 1, "maximum": 32},
        "base": {"oneOf": [{"$ref": "#/$defs/run_output"}, {"type": "null"}]},
        "candidate": {"oneOf": [{"$ref": "#/$defs/run_output"}, {"type": "null"}]}
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input", "purpose", "input_artifact", "stable", "different",
        "in_observation_domain", "base_within_contract", "candidate_within_contract", "runs"
      ],
      "properties": {
        "input": {"$ref": "#/$defs/token"},
        "purpose": {"enum": ["selected", "shrink"]},
        "input_artifact": {"$ref": "#/$defs/artifact"},
        "stable": {"oneOf": [{"type": "boolean"}, {"type": "null"}]},
        "different": {"oneOf": [{"type": "boolean"}, {"type": "null"}]},
        "in_observation_domain": {"oneOf": [{"type": "boolean"}, {"type": "null"}]},
        "base_within_contract": {"oneOf": [{"type": "boolean"}, {"type": "null"}]},
        "candidate_within_contract": {"oneOf": [{"type": "boolean"}, {"type": "null"}]},
        "runs": {"type": "array", "items": {"$ref": "#/$defs/sample_run"}}
      }
    },
    "shrink_attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "reused"],
      "properties": {
        "input": {"$ref": "#/$defs/token"},
        "reused": {"type": "boolean"}
      }
    },
    "shrinking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limit", "seed_input", "reduced_input", "attempted_inputs", "complete"],
      "properties": {
        "limit": {"type": "integer", "minimum": 0, "maximum": 256},
        "seed_input": {"oneOf": [{"$ref": "#/$defs/token"}, {"type": "null"}]},
        "reduced_input": {"oneOf": [{"$ref": "#/$defs/token"}, {"type": "null"}]},
        "attempted_inputs": {"type": "array", "items": {"$ref": "#/$defs/shrink_attempt"}},
        "complete": {"type": "boolean"}
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["side", "state", "argv", "stdout", "stderr"],
      "properties": {
        "side": {"enum": ["base", "candidate"]},
        "state": {"enum": ["not_required", "not_run", "built", "failed"]},
        "argv": {"type": "array", "items": {"type": "string"}},
        "stdout": {"oneOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]},
        "stderr": {"oneOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]}
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "classification", "reason", "message", "artifacts"],
      "properties": {
        "stage": {"type": "string", "minLength": 1},
        "classification": {"enum": ["unknown", "infrastructure_failure"]},
        "reason": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}}
      }
    }
  }
}
