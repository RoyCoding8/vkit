{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vkit.local/schemas/run-report.v1.json",
  "title": "vkit run report, schema version 1",
  "description": "The durable record of one check run. Published atomically; a reader never sees half of one.",
  "type": "object",
  "required": ["schema_version", "run_id", "check_id", "lifecycle", "outcome", "source", "command", "started_at", "ended_at"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "check_id": { "type": "string", "minLength": 1 },
    "lifecycle": { "enum": ["preparing", "running", "terminal"] },
    "started_at": { "type": "string", "minLength": 1 },
    "ended_at": { "type": ["string", "null"] },
    "outcome": {
      "description": "Exactly one variant. A terminal run without one is not publishable.",
      "oneOf": [
        {
          "type": "object",
          "required": ["result", "scenarios"],
          "additionalProperties": false,
          "properties": {
            "result": { "const": "PASS" },
            "scenarios": { "$ref": "#/$defs/scenarios" }
          }
        },
        {
          "type": "object",
          "required": ["result", "scenarios"],
          "additionalProperties": false,
          "properties": {
            "result": { "const": "FAIL" },
            "scenarios": { "$ref": "#/$defs/scenarios" }
          }
        },
        {
          "type": "object",
          "required": ["result", "reason"],
          "additionalProperties": false,
          "properties": {
            "result": { "const": "BLOCKED" },
            "reason": {
              "enum": [
                "prerequisite_missing", "tool_missing", "timeout", "cancelled", "interrupted",
                "artifact_missing", "artifact_malformed", "artifact_empty", "scenario_unknown",
                "source_changed", "ownership_lost", "launch_failed", "internal_error"
              ]
            },
            "detail": { "type": "string" }
          }
        }
      ]
    },
    "source": { "$ref": "#/$defs/sourceIdentity" },
    "command": { "$ref": "#/$defs/commandIdentity" },
    "configuration_digest": { "type": "string", "minLength": 1 },
    "fixture_digest": { "type": ["string", "null"] },
    "process": {
      "type": ["object", "null"],
      "required": ["pid", "ownership"],
      "additionalProperties": false,
      "properties": {
        "pid": { "type": "integer" },
        "creation_time": {
          "type": "integer",
          "minimum": 0,
          "description": "The process's start time, which together with the pid identifies it beyond pid reuse. On Windows this is the creation FILETIME as 100ns ticks since 1601, a value near 1.34e17, so a JSON reader that parses numbers as floats will corrupt it; read it as an integer. On POSIX it is /proc/<pid>/stat field 22, ticks since boot, which is small and is only meaningful alongside boot_id. The two are not interchangeable, so a record written on one platform does not verify on the other, which is the safe direction."
        },
        "boot_id": {
          "type": "string",
          "minLength": 1,
          "description": "POSIX only, and absent on Windows. The kernel's per-boot identifier, compared as part of the identity because a start time is ticks since boot: WSL restarts the init namespace, so a record written before a restart must read as a stranger rather than as a match."
        },
        "job_name": {
          "type": "string",
          "minLength": 1,
          "description": "Name of the Windows job object owning this run's tree, so another process can terminate it. Unguessable: anyone who can open it can kill the run."
        },
        "ownership": { "enum": ["windows_job_object", "posix_process_group"] },
        "exit_code": { "type": ["integer", "null"] },
        "timed_out": { "type": "boolean" }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "Run-relative paths. Every value must canonicalize inside the run directory."
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "python_version": { "type": "string" },
        "platform": { "type": "string" },
        "git_version": { "type": "string" },
        "tool_versions": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["mode"],
      "additionalProperties": false,
      "description": "Who produced this run. `ambient` is a development run, executed by whatever interpreter happened to import vkit. `trusted_integration` is the Plan 07 path, where the verifier revision, the interpreter and the artifact capture are named rather than inherited.",
      "properties": {
        "mode": { "enum": ["ambient", "trusted_integration"] },
        "verifier_revision": { "type": "string", "minLength": 1 },
        "python": { "type": "string", "minLength": 1 },
        "plugin_root": { "type": "string", "minLength": 1 },
        "artifact_capture": { "enum": ["verifier"] },
        "artifact_revalidated": { "enum": ["yes", "no"] }
      }
    },
    "logs": {
      "type": ["object", "null"],
      "required": ["stdout", "stderr"],
      "additionalProperties": false,
      "properties": {
        "stdout": { "type": ["string", "null"] },
        "stderr": { "type": ["string", "null"] }
      }
    }
  },
  "$defs": {
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "result", "observation"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "result": { "enum": ["PASS", "FAIL"] },
          "observation": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sourceIdentity": {
      "type": "object",
      "required": ["head", "inventory_digest", "dirty"],
      "additionalProperties": false,
      "properties": {
        "head": { "type": "string", "minLength": 1 },
        "inventory_digest": { "type": "string", "minLength": 1 },
        "dirty": { "type": "boolean" },
        "tracked_files": { "type": "integer", "minimum": 0 },
        "dirty_paths": { "type": "array", "items": { "type": "string" } }
      }
    },
    "commandIdentity": {
      "type": "object",
      "required": ["argv", "cwd"],
      "additionalProperties": false,
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "The exact list executed. Never a joined shell string."
        },
        "cwd": { "type": "string", "minLength": 1 }
      }
    }
  }
}
