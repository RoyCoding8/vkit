Screen {
    background: #10151c;
    color: #dce5f0;
}
Header, Footer {
    background: #1c2937;
}
TabbedContent {
    height: 1fr;
}
Tabs {
    background: #16212d;
}
Tab.-active {
    color: #85c9ff;
    text-style: bold;
}
TabPane {
    padding: 0 1;
}
.card {
    border: round #3b536b;
    background: #151e28;
    padding: 0 1;
}
.heading {
    color: #85c9ff;
    text-style: bold;
    margin-bottom: 1;
    margin-top: 0;
}
.hint {
    color: #a4b5c8;
    margin: 0 0 1 0;
    height: auto;
}
.feedback {
    height: auto;
    margin-top: 1;
}
Label {
    margin-top: 1;
}
Button {
    width: 100%;
}
Input {
    margin: 1 0;
}
Checkbox {
    margin: 1 0;
}
#home-cards {
    height: auto;
}
#repository-card {
    width: 1fr;
    height: auto;
    margin-right: 2;
}
#current-project {
    height: auto;
}
#server-card {
    width: 1fr;
    min-width: 28;
    height: auto;
}
#server-status {
    height: auto;
    margin-bottom: 1;
}
#check-actions {
    width: 31;
    margin-right: 2;
}
#result-card {
    width: 1fr;
}
RichLog, TextArea {
    height: 1fr;
}
Screen.compact #home-cards, Screen.compact #checks-body {
    layout: vertical;
}
Screen.compact #repository-card, Screen.compact #server-card {
    width: 100%;
    margin: 0 0 1 0;
}
Screen.compact #check-actions {
    width: 100%;
    height: 10;
    margin: 0 0 1 0;
}
